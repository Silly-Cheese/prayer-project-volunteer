rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return signedIn()
        && request.auth.token.email == 'christophershelley257@gmail.com';
    }

    function volunteerDoc() {
      return /databases/$(database)/documents/volunteers/$(request.auth.uid);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          ownerEmail()
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (
            exists(volunteerDoc())
            && get(volunteerDoc()).data.permissions.hasAny(['admin:limited'])
          )
        );
    }

    function isTrainer() {
      return signedIn()
        && (
          isAdmin()
          || (
            exists(volunteerDoc())
            && get(volunteerDoc()).data.permissions.hasAny(['training:trainer'])
          )
        );
    }

    /*
      MAIN PRAYER PROJECT SITE
    */

    match /prayer_requests/{requestId} {
      allow read: if resource.data.status == 'approved'
                  || resource.data.status == 'answered'
                  || isAdmin();

      allow create: if request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.email is string
        && request.resource.data.category is string
        && request.resource.data.urgent is bool
        && request.resource.data.prayerCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.answered == false
        && request.resource.data.status == 'approved';

      allow update: if isAdmin()
        || (
          resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['prayerCount','updatedAt'])
          && request.resource.data.prayerCount == resource.data.prayerCount + 1
        )
        || (
          resource.data.status == 'approved'
          && request.resource.data.status == 'reported'
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reportCount','status','updatedAt'])
        );

      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if request.resource.data.requestId is string
        && request.resource.data.email is string
        && request.resource.data.emailKey is string
        && request.resource.data.category is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /report_bans/{banId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /*
      VOLUNTEER APPLICATIONS AND ACTIVATION
    */

    match /volunteer_applications/{applicationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.emailKey is string
        && request.resource.data.why is string
        && request.resource.data.status == 'submitted';
      allow read, update, delete: if isAdmin();
    }

    match /volunteer_invites/{inviteId} {
      /* Public get is required so an applicant can check their temporary code before their Auth account exists. */
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      /* Admins may update anything. A newly signed-in activating user may only mark their own invite used. */
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.emailKey == inviteId
          && request.resource.data.emailKey == resource.data.emailKey
          && request.resource.data.email == resource.data.email
          && resource.data.used == false
          && resource.data.status == 'active'
          && request.resource.data.used == true
          && request.resource.data.status == 'used'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['used','usedAt','uid','status'])
        );
    }

    match /volunteers/{volunteerId} {
      allow read: if isSelf(volunteerId) || isAdmin() || isTrainer();

      /* Activation may create the volunteer profile after the temporary code is verified client-side. */
      allow create: if isSelf(volunteerId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin()
        || (
          isSelf(volunteerId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'agreementAccepted','agreementAcceptedAt','trainingCompleted','trainingCompletedAt','updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /chapter_members/{memberId} {
      allow read: if isAdmin() || isTrainer();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /*
      CHAPTERS
    */

    match /volunteer_chapter_requests/{chapterId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.emailKey is string
        && request.resource.data.chapterName is string
        && request.resource.data.purpose is string
        && request.resource.data.status == 'submitted';
      allow update, delete: if isAdmin();
    }

    match /volunteer_chapters/{chapterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /chapter_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    /*
      TRAINING
    */

    match /volunteer_training_plans/{planId} {
      allow read: if isAdmin() || isTrainer() || isSelf(planId);
      allow create, update, delete: if isAdmin() || isTrainer();
    }

    match /volunteer_training_completions/{completionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reflection is string;
      allow read, update, delete: if isAdmin() || isTrainer();
    }

    /*
      ASSIGNMENTS AND SERVICE
    */

    match /volunteer_assignments/{assignmentId} {
      allow read: if isAdmin()
        || isTrainer()
        || (signedIn() && resource.data.assignedToUid == request.auth.uid);
      allow create, delete: if isAdmin() || isTrainer();
      allow update: if isAdmin()
        || isTrainer()
        || (
          signedIn()
          && resource.data.assignedToUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','completedAt','volunteerResponse','updatedAt'])
        );
    }

    match /volunteer_activity_updates/{activityId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin() || isTrainer();
    }

    match /volunteer_service_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.summary is string;
      allow read, update, delete: if isAdmin() || isTrainer();
    }

    match /volunteer_care_projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.purpose is string
        && request.resource.data.status == 'submitted';
      allow read, update, delete: if isAdmin() || isTrainer();
    }

    match /volunteer_contacts/{contactId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /volunteer_leave_requests/{leaveId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /volunteer_suggestions/{suggestionId} {
      allow create: if request.resource.data.title is string
        && request.resource.data.details is string
        && request.resource.data.status == 'submitted';
      allow read, update, delete: if isAdmin();
    }

    match /volunteer_announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_notes/{noteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_notes/{noteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /volunteer_badges/{badgeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    /*
      ADMIN AND AUDIT
    */

    match /admins/{adminId} {
      allow read: if signedIn();
      allow create, update, delete: if ownerEmail();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    /*
      OPTIONAL EXPANSION COLLECTIONS
    */

    match /volunteer_program_status/{statusId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_permissions/{permissionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_roles/{roleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_teams/{teamId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
